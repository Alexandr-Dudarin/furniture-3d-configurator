{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/feedback/:path*", "destination": "/index.html" },
    { "source": "/catalog/:path*", "destination": "/index.html" },
    { "source": "/viewer/:path*", "destination": "/index.html" }
  ]
}
